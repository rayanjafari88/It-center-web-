# Copy to .env and fill in. Never commit .env.

# The hostname staff will use. Caddy obtains a certificate for it automatically.
SITE_ADDRESS=itcc.example.com

# Mail delivery for sign-in codes.
# Leave as "log" to write codes to the container log while testing.
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=it-helpdesk@example.com
SMTP_PASS=
SMTP_FROM=it-helpdesk@example.com

# Optional
MAX_UPLOAD_BYTES=10485760
BACKUP_KEEP=48

# --- Option B: Microsoft Graph instead of SMTP ---------------------------------
# Use when the tenant does not allow SMTP AUTH. Set MAIL_TRANSPORT=graph and fill
# these in; the SMTP_* values above are then ignored.
# MAIL_TRANSPORT=graph
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_SENDER=it-helpdesk@example.com
